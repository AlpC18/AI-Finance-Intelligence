# AI Finance Intelligence - environment config
# Copy to .env and fill in. .env is git-ignored.

# --- Claude (AI). Empty -> AI runs in degraded mode (quant only). ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=1024

# --- Cache: "memory" (single worker) or "redis" (multi-worker). ---
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=120

# --- Rate limit for AI/market endpoints (slowapi syntax). ---
RATE_LIMIT_AI=5/minute

# --- Auth (JWT). MUST set a strong 32+ byte secret in production. ---
JWT_SECRET=dev-insecure-change-me-please-set-a-strong-32byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Persistence / server ---
DATABASE_URL=sqlite:///./finance.db
HOST=127.0.0.1
PORT=8000

# --- Trade execution (paper-first broker integration) ---
TRADE_ENABLED=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
MAX_ORDER_NOTIONAL=10000
MIN_TRADE_CONFIDENCE=0.0
RATE_LIMIT_TRADE=10/minute

# --- Encryption at rest (Fernet). REQUIRED in production. ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Execution reconciliation + position sync (background workers) ---
ORDER_RECONCILIATION_ENABLED=true
ORDER_POLL_INTERVAL_SECONDS=30
POSITION_SYNC_ENABLED=true
POSITION_SYNC_INTERVAL_MINUTES=15

# --- Broker webhook ingestion (Alpaca trade updates). ---
# Event-driven fills: the broker POSTs each trade update to /api/trade/webhook,
# authenticated with this shared secret in the X-Webhook-Secret header. Empty ->
# the endpoint is disabled (503) and only the polling backstop runs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADE_WEBHOOK_SECRET=

# --- Multi-channel alert fallback (used when no live WebSocket is reachable). ---
# Both sinks are optional and best-effort; a delivery failure never breaks alerts.
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@ai-finance.local
SMTP_USE_TLS=true

# --- Distributed tracing (OpenTelemetry). Off by default. ---
# With no OTLP endpoint the SDK still propagates context but drops spans.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-finance-intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=

# ENCRYPTION_KEY supports rotation: comma-separated keys, PRIMARY first, older
# keys retained for decryption. Rotate by prepending a new key then calling the
# KeyRotationService to re-encrypt stored credentials. Example:
# ENCRYPTION_KEY=<new-primary>,<previous-key>
